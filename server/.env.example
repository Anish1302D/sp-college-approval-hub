# Copy to .env and fill in. Never commit .env.

PORT=4000

# Must connect as app_user. The API refuses to start as postgres or any role
# that bypasses Row-Level Security. Give app_user a password first:
#   ALTER ROLE app_user LOGIN PASSWORD '...';
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5433/spc_approval

# At least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Seals recorded approvals. Keep it stable: changing it makes every existing
# seal report MISMATCH. Keep it separate from JWT_SECRET.
SIGNING_SECRET=

# Where attachments are written. Back this up together with the database.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# The frontend's origin(s), comma-separated.
CORS_ORIGIN=http://localhost:3000

# Tests only: a superuser connection used to build the throwaway test database.
TEST_ADMIN_URL=postgresql://postgres:devpass@localhost:5433/postgres
